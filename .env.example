# Copy to .env and fill in. Never commit .env.

# Public IP of the AMD Developer Cloud GPU droplet (1x MI300X). SSH as root.
DROPLET_HOST=
# Optional: SSH user and key if not root / default key.
DROPLET_USER=root
DROPLET_SSH_KEY=

# Shared secret passed to both vLLM servers as --api-key. Any long random string.
VLLM_API_KEY=

# OpenAI-compatible base URLs served by vLLM on the droplet.
# remote_setup.sh prints the values to use, normally:
#   LLM_URL=http://<DROPLET_HOST>:8000/v1
#   EMBED_URL=http://<DROPLET_HOST>:8001/v1
LLM_URL=
EMBED_URL=

# Model ids as served by vLLM.
LLM_MODEL=openai/gpt-oss-120b
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# Optional: Hugging Face token for the droplet. gpt-oss-120b and the Qwen models are not gated.
HF_TOKEN=

# Web app: "replay" serves cached results with no GPU, "live" calls the droplet.
FAULTLINE_MODE=replay

# GPU rental price used for cost-per-alert figures. Check the droplet's Create page.
GPU_USD_PER_HOUR=2.59
